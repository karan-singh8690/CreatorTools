generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PdfFile {
  id              String   @id @default(cuid())
  name            String
  originalName    String
  size            Int      @default(0)
  mimeType        String   @default("application/pdf")
  pages           Int      @default(1)
  starred         Boolean  @default(false)
  textContent     String?  // Extracted text for AI chat
  filePath        String   // Path to stored file

  // Production-grade upload fields
  fileHash        String?  // SHA256 hash for duplicate detection
  uploadStatus    String   @default("ready") // uploading | processing | ready | error | duplicate
  metadata        String?  // JSON string: { author, title, creator, creationDate, modDate, pdfVersion, isEncrypted, isLinearized }
  thumbnailPath   String?  // Path to first-page thumbnail image
  virusScanStatus String   @default("pending") // pending | clean | threat | skipped
  virusScanResult String?  // Scan result details
  chunkUploadId   String?  // Reference to active chunk upload session
  errorMessage    String?  // Last error message if uploadStatus is 'error'

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fileHash])
  @@index([uploadStatus])
}

model UploadLog {
  id          String   @id @default(cuid())
  fileId      String?  // Reference to PdfFile (null if upload failed before DB entry)
  fileName    String
  fileSize    Int      @default(0)
  fileHash    String?  // SHA256 hash
  status      String   @default("started") // started | completed | failed | duplicate_rejected
  errorType   String?  // validation_error | size_exceeded | duplicate | virus_detected | chunk_failed | server_error
  errorMessage String?
  uploadDurationMs Int? // Time from start to completion
  clientIp    String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model ChunkUploadSession {
  id              String   @id @default(cuid())
  fileName        String
  fileSize        Int      @default(0)
  fileHash        String?  // Pre-computed hash from client
  totalChunks     Int
  uploadedChunks  String   @default("[]") // JSON array of received chunk indices
  status          String   @default("active") // active | completed | expired | failed
  uploadDir       String   // Directory for temporary chunk files
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}
